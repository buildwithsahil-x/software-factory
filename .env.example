# Copy to .env (in the repo root or backend/) and fill in. Never commit .env.

# Claude API key used by all factory agents.
ANTHROPIC_API_KEY=

# Where the factory stores its database and agent workspaces.
# FACTORY_DATA_DIR=/home/factory/.software-factory

# How many agents may run at the same time (raise when the VM is upgraded).
# FACTORY_MAX_CONCURRENT_AGENTS=3

# OS-level sandbox for agent shell commands (Linux needs bubblewrap installed).
# FACTORY_BASH_SANDBOX=false

# Origins allowed to call the API (JSON list).
# FACTORY_CORS_ORIGINS=["http://localhost:5173"]
